# Public Spotify application ID. Never put a client secret here.
VITE_SPOTIFY_CLIENT_ID=
# Exact Pages entry URL (no hash); register it in Spotify Developer Dashboard.
# Production example: https://YOUR-NAME.github.io/songoftheweek/
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/
VITE_SPOTIFY_PLAYBACK_DELAY_MS=900
# Optional own sound, relative to the app root, e.g. assets/audio/cassette-start.mp3
# Empty uses the included synthesized mechanical switch sound.
VITE_CASSETTE_START_SOUND_URL=
